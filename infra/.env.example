# Public DNS hostname, without a scheme, port or path.
API_DOMAIN=
# Generate independently with openssl rand -hex 32 and openssl rand -base64 32.
DB_PASSWORD=
JWT_SECRET=
# Set to false to close registration while keeping sign-in available.
APP_REGISTRATION_ENABLED=true

# SMTP and public HTTPS URLs for both account recovery flows.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_ACCOUNT_RECOVERY_PAGE=
APP_PASSWORD_RESET_PAGE=

# Native Android via Expo and iPhone Home Screen app via Web Push.
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
